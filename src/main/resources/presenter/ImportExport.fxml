<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.milos970.controller.ImportExportController">
   <children>
      <VBox alignment="CENTER" layoutX="40.0" layoutY="-20.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button fx:id="exportButton" mnemonicParsing="false" onAction="#exportFile" text="Export data" />
            <Label fx:id="exportErrorLabel" textFill="RED">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button fx:id="importButton" mnemonicParsing="false" onAction="#importFile" text="Import data">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin></Button>
            <Label fx:id="importErrorLabel" textFill="RED">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#generate" text="Generate data">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin></Button>
            <Label fx:id="generateErrorLabel" textFill="RED">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
