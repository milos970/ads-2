<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="900.0" styleClass="text-field" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.milos970.controller.MenuController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="800.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <TabPane fx:id="tabPane" prefHeight="800.0" prefWidth="860.0" tabClosingPolicy="UNAVAILABLE">
               <tabs>
                  <Tab fx:id="patientTab" text="Patient" />
                  <Tab fx:id="testTab" text="PCR test" />
                  <Tab fx:id="filteringTab" text="Filtering" />
                  <Tab fx:id="importExportTab" text="Import/Export" />
               </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
